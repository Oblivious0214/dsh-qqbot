{
  "name": "dsh-qqbot",
  "version": "0.37.0",
  "description": "QQ 聊天角色扮演：独立预设、角色、记忆、语音与可单独关闭的设备联动。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "qq",
    "persona",
    "roleplay"
  ],
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oblivious0214/dsh-qqbot.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./prompt": {
      "types": "./lib/types/prompt.d.ts",
      "default": "./lib/prompt.js"
    },
    "./compaction": {
      "types": "./lib/types/compaction.d.ts",
      "default": "./lib/compaction.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "README.md",
    "docs/funscript-storage.md",
    "assets/*.png",
    "assets/*.gif",
    "assets/motion-presets/**",
    "examples/*.json",
    "docs/usage.md",
    "docs/development.md",
    "docs/images/*"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../qqbot/src/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../../qqbot/src/deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-agent-preset-registry": "link:../../qqbot/src/deepseek-harness/packages/preset/agent-preset-registry",
    "@deepseek-ai/dsh-api-session-controller": "link:../../qqbot/src/deepseek-harness/packages/api/session-controller",
    "@deepseek-ai/dsh-client-connection": "link:../../qqbot/src/deepseek-harness/packages/client/connection",
    "@deepseek-ai/dsh-client-store": "link:../../qqbot/src/deepseek-harness/packages/client/store",
    "@deepseek-ai/dsh-client-ui-chat": "link:../../qqbot/src/deepseek-harness/packages/client/ui-chat",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../qqbot/src/deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-layout": "link:../../qqbot/src/deepseek-harness/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../qqbot/src/deepseek-harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../qqbot/src/deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-session": "link:../../qqbot/src/deepseek-harness/packages/client/ui-session",
    "@deepseek-ai/dsh-client-ui-settings": "link:../../qqbot/src/deepseek-harness/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-sidebar": "link:../../qqbot/src/deepseek-harness/packages/client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "link:../../qqbot/src/deepseek-harness/packages/client/ui-sidebar-right",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../qqbot/src/deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-workspace": "link:../../qqbot/src/deepseek-harness/packages/client/ui-workspace",
    "@deepseek-ai/dsh-commands": "link:../../qqbot/src/deepseek-harness/packages/interaction/commands",
    "@deepseek-ai/dsh-compaction": "link:../../qqbot/src/deepseek-harness/packages/compaction/compaction",
    "@deepseek-ai/dsh-compaction-basic": "link:../../qqbot/src/deepseek-harness/packages/compaction/compaction-basic",
    "@deepseek-ai/dsh-host-webserver": "link:../../qqbot/src/deepseek-harness/packages/host/webserver",
    "@deepseek-ai/dsh-llm": "link:../../qqbot/src/deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-system-prompt": "link:../../qqbot/src/deepseek-harness/packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "link:../../qqbot/src/deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-working-directory": "link:../../qqbot/src/deepseek-harness/packages/session/working-directory",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "~18.3.7",
    "@zip.js/zip.js": "2.24.0",
    "cropperjs": "1.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "undici": "^8.11.2"
  }
}
